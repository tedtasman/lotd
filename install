#!/usr/bin/env bash
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
NAME="${SCRIPT_DIR##*/}" 

# install in ~/.local/bin
mkdir -p ~/.local/bin
ln -s "$SCRIPT_DIR/lotd-now" "$HOME/.local/bin/lotd-now" && printf "lotd-now installed at ~/.local/bin/lotd-now\n"



# ~/.local/bin to PATH if not there
if ! [[ ":$PATH:" == *":$HOME/.local/bin:"* ]] && ! grep -q '$HOME/.local/bin' ~/.bashrc; then
    cat >> ~/.bashrc <<'EOF'

# lotd-now - add ~/.local/bin to PATH
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
EOF

    . "$HOME/.bashrc" && printf "~/.local/bin/ added to PATH\n"
fi

! [[ -e /etc/update-motd.d ]] && echo "Failed to add lotd to Message of the Day, /etc/update-motd.d missing" && exit 1

echo "Authorize write to /etc/update-motd.d:"
sudo ln -s "$SCRIPT_DIR/lotd-now" "/etc/update-motd.d/1000-lotd" && echo "Lottery of the Day added to Message of the Day"
